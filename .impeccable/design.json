      "css": ".ds-next{display:flex;flex-direction:column;justify-content:center;width:100%;height:72px;background:var(--green,#0B5D44);color:#fff;text-align:left;padding:0 18px;border:0;border-radius:0;box-shadow:0 6px 18px rgb(18 18 18 / .22);cursor:pointer}.ds-next span{font-size:13px;color:#D5E8DE}.ds-next b{font-size:22px;font-weight:900}.ds-next:active{transform:translateY(1px)}.ds-next:focus-visible{outline:3px solid var(--green-ink,#0B6B4B);outline-offset:2px}"
