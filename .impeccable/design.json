      "html": "<div class=\"ds-seg\"><span class=\"on\">아침</span><span>점심</span><span>저녁</span><span>간식</span></div>",
      "css": ".ds-seg{display:grid;grid-template-columns:repeat(4,1fr);border:1.5px solid var(--ink,#121212)}.ds-seg span{display:grid;place-items:center;min-height:44px;font-size:15px;border-left:1px solid var(--ink,#121212);cursor:pointer}.ds-seg span:first-child{border-left:0}.ds-seg span:hover{background:var(--paper,#EEF1EF)}.ds-seg span.on{background:var(--ink,#121212);color:#fff}"
    }
